# Specter Platform — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# ── Application ──────────────────────────────────────────────────────────────
SPECTER_ENV=development          # development | staging | production
SPECTER_SECRET_KEY=change-me-in-production-use-secrets-generate
SPECTER_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./specter.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/specter

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Credential Store ──────────────────────────────────────────────────────────
# Fernet key for encrypting API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_FERNET_KEY=

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SONNET_MODEL=claude-sonnet-4-6
OPUS_MODEL=claude-opus-4-7

# ── Collection APIs (optional — reduces capability if absent) ─────────────────
HIBP_API_KEY=
INTELX_API_KEY=
EMAILREP_API_KEY=
SHODAN_API_KEY=
FACECHECK_API_KEY=
DARKOWL_API_KEY=

# ── Alert Channels ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=specter@yourorg.com
SIEM_WEBHOOK_URL=

# ── Enrichment Engine ─────────────────────────────────────────────────────────
ENGINE_MAX_DEPTH=4
ENGINE_MAX_SEEDS=50
ENGINE_TIME_LIMIT_MINUTES=30
ENGINE_CONCURRENCY=5

# ── Ethics Constraints (do not change) ────────────────────────────────────────
PASSIVE_ONLY=true
NO_CREDENTIAL_EXTRACTION=true
NO_DPPA_QUERIES=true
NO_FCRA_QUERIES=true
PUBLIC_SOURCES_ONLY=true
AUDIT_ALL_ACTIONS=true
